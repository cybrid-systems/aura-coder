(define rk-dec
  (lambda (s off w)
    (letrec ((loop (lambda (i v)
       (if (< i w) (loop (+ i 1) (+ (* v 10) (- (string-ref s (+ off i)) 48))) v))))
      (loop 0 0))))
(define rk-block-seek (lambda (blk key n ra) 0))
(define rk-pad
  (lambda (n w)
    (let ((s (number->string n)))
      (if (> (string-length s) w)
          (error "overflow")
          (letrec ((loop (lambda (s) (if (< (string-length s) w) (loop (string-append "0" s)) s)))) (loop s))))))
(define rk-block-build
  (lambda (blob)
    (letrec ((loop (lambda (off n offs)
               (if (>= off (string-length blob))
                   (string-append blob (apply string-append (reverse offs)) (rk-pad n 6))
                   (loop (+ off 11 (rk-dec blob (+ off 1) 4) (rk-dec blob (+ off 5) 6)) (+ n 1) (cons (rk-pad off 6) offs))))))
      (loop 0 0 (list)))))
(define rk-block-get (lambda (blk key) (rk-block-seek blk key 0 0)))
(define rk-cs (lambda (c) (if (null? c) 0 c)))
