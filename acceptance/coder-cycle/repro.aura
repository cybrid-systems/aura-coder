;; aura-coder's own loop shape: seed policy, three sequential rebinds (rank, budget, classify) each followed by
;; eval-current, then snapshot -> rebind -> restore -> eval-current must give back the previous decisions.
(set-code (read-file "../../aura/policy_seed.aura"))
(eval-current)
(define s0 (ast:snapshot "seed"))
(mutate:rebind "rank" "(lambda (cls) (cond ((equal? cls \"L0\") (list \"add_import\")) ((equal? cls \"off-by-one\") (list \"index_shift\")) (else (list))))" "t")
(eval-current)
(mutate:rebind "budget" "(lambda (cls) (cond ((equal? cls \"L0\") 6) (else 8)))" "t")
(eval-current)
(mutate:rebind "classify" "(lambda (etype msg delta node) (cond ((equal? msg \"can only concatenate str (not \\\"int\\\") to str\") \"L0\") ((equal? delta \"off-by-one\") \"off-by-one\") (else \"unknown\")))" "t")
(eval-current)
(define d1 (decide "TypeError" "can only concatenate str (not \"int\") to str" "-" "Return"))
(define d2 (decide "AssertionError" "-" "off-by-one" "-"))
(define s1 (ast:snapshot "v3"))
(mutate:rebind "rank" "(lambda (cls) (list \"cast_str\"))" "t")
(eval-current)
(ast:restore s1)
(eval-current)
(define d3 (decide "AssertionError" "-" "off-by-one" "-"))
(display (list (car d1) (cadr d1) (car (caddr d1)) (car d2) (car (caddr d2)) (equal? d2 d3))) (newline)
